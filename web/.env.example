# ---------------------------------------------------------------------------
# Wind Ops — environment variables. Copy to .env.local (local) or set them in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# --- Google Sheets (read-only service account) ---------------------------
# The spreadsheet IDs are the long strings in each sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_WORKSTUDY_ID=
SHEET_LEAVE_ID=
SHEET_OVERTIME_ID=
# Paste the whole service-account JSON key (or base64 of it) on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=
# …or instead provide the two fields separately:
# GOOGLE_CLIENT_EMAIL=wind-ops-reader@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Database (Supabase Postgres) ----------------------------------------
# Supabase → Connect → Direct → "Session pooler" (port 5432, user postgres.<project-id>).
# Not the Transaction pooler (6543: pages hang) or Direct connection (IPv6-only).
# Password: letters, digits and _ only.
DATABASE_URL=

# --- Sign-in (Google OAuth, company domain only) --------------------------
AUTH_SECRET=                 # generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_GOOGLE_ID=              # OAuth client ID  (Google Cloud → APIs & Services → Credentials)
AUTH_GOOGLE_SECRET=          # OAuth client secret
ALLOWED_EMAIL_DOMAIN=zeitview.com
ADMIN_EMAILS=                # comma-separated; these accounts are always admin
DEFAULT_ROLE=viewer          # role for anyone else who signs in: viewer | lead | manager | admin

# --- Scheduled sync ---------------------------------------------------------
CRON_SECRET=                 # long random string; the scheduler sends it as "Authorization: Bearer …"
APP_URL=                     # e.g. https://wind-ops.vercel.app (used in notification links)

# --- Optional notifications (nothing is sent unless also enabled in Settings) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- Local development only ----------------------------------------------
# SHEETS_FIXTURE_FILE=fixtures/demo.json   # read a synthetic snapshot instead of Google Sheets
# APP_TODAY=2026-11-23                     # pin "today" (IST) for demos/tests
# AUTH_DEV_BYPASS=1                        # skip sign-in (ignored in production builds)
# PGLITE_DIR=.data/pglite                  # embedded Postgres used when DATABASE_URL is empty
